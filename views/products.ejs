<!DOCTYPE html>
<html lang="en">

    <%- include('include/head') %>

    <style>
        .bg-image-breadcrumb {
            background-image: url(/nmenterpriseimages/banner/product.png);
        }
    </style>

    <body class="home-inner home-green">

        <!-- Header Start -->
        <div class="loader-wrapper">
            <div class="loader">
            </div>
            <div class="loader-section section-left"></div>
            <div class="loader-section section-right"></div>
        </div>

        <%- include('include/header') %>

            <!-- tmp breadcrumba area start -->
            <div class="tmp-bread-crumb-area bg-breadcrumb bg-image-breadcrumb bg_image">
                <div class="container-3">
                    <div class="row">
                        <div class="col-lg-12">
                            <!-- bread crumb inner wrapper -->
                            <div class="breadcrumb-inner ptb--100 ptb_sm--100 text-center">
                                <h1 class="title">Our Products</h1>
                                <div class="meta">
                                    <a href="/" class="prev"><i class="fa-solid fa-house"></i> Home</a>
                                    <span><i class="fa-regular fa-chevron-right"></i></span>
                                    <span>Our Products</span>
                                </div>
                            </div>
                            <!-- bread crumb inner wrapper end -->
                        </div>
                    </div>
                </div>
            </div>
            <!-- tmp breadcrumba area end -->

            <!-- Blog Area Start -->
            <section class="tmp-service-area area-5 tmp-section-gap">
                <div class="container-3">
                    <div class="section-title-area-3">


                        <h2 class="section-title tmp-title-split" data-sal="slide-up" data-sal-duration="800"
                            data-sal-delay="300">
                            Quality Parts <br> For RMC & Concrete Equipment
                        </h2>
                    </div>
                    <div class="section-inner mt--60 mt_sm--40">
                        <div class="row g-5">

                            <% products.forEach((product)=> { %>

                                <div class="col-xl-3 col-lg-3 col-md-4">
                                    <div class="blog-card-style-two inner">

                                        <div class="image-area">
                                            <img src="<%= product.image %>" alt="<%= product.alt %>">
                                        </div>

                                        <div class="blog-content-area-2" style="background-color: #CDA267;">
                                            <div class="text text-justify">

                                                <h3 class="blog-title" style="color: #ffff;">
                                                    <%= product.title %>
                                                </h3>

                                            </div>

                                        </div>

                                    </div>
                                </div>

                                <% }) %>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Blog Area End -->

            <!-- tmp footer area start -->
            <%- include('include/footer') %>

            <%- include('include/mobileHeader') %>