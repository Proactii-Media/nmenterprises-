<!DOCTYPE html>
<html lang="en">

<style>
    .tmpServiceSlider .swiper-wrapper {
        align-items: stretch;
    }

    .tmpServiceSlider .swiper-slide {
        height: auto;
        display: flex;
    }

    .tmpServiceSlider .service-wrapper-3 {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .tmpServiceSlider .top-content {
        min-height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tmpServiceSlider .image-area {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .tmpServiceSlider .image-area>a {
        display: block;
    }

    .tmpServiceSlider .image-area img {
        width: 100%;
        height: 450px;
        object-fit: cover;
        display: block;
    }

    .tmpServiceSlider .image-area .content {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .tmp-counter-area .content {
        padding: 0;
        border: 2px solid transparent;
        border-radius: 12px;
        /* transition: all 0.3s ease; */
    }

    .tmp-counter-area .content:hover {
        padding: 3px;
        border-color: #e80028;
    }

    .why-choose-wrapper-list2 .icon i {
        color: #460fdd;
    }

    .service-wrapper7 {
        position: relative;
        overflow: hidden;
    }

    .service-wrapper7::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 0;
        height: 2px;
        background: #e80028;
        /* transition: width 0.2s ease; */
    }

    .service-wrapper7:hover::after {
        width: 100%;
    }

    .service-wrapper7 .icon {
        width: 90px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff1f2;
        border-radius: 50%;
    }

    .service-wrapper7 .icon img {
        width: 50px;
        height: 50px;
        object-fit: contain;
    }

    .banner-area-hydro-power-area {
        background-image: url(/nmenterpriseimages/banner/homeslider1.png);
        height: 860px;
        padding-bottom: 30px;
        position: relative;
        z-index: 1;
    }
</style>


<%- include('include/head') %>

    <body class="home-one">

        <!-- Header Start -->
        <div class="loader-wrapper">
            <div class="loader">
            </div>
            <div class="loader-section section-left"></div>
            <div class="loader-section section-right"></div>
        </div>
        <!-- header srea start -->
        <%- include('include/header') %>
            <!-- header srea end -->


            <!-- Header End -->

            <!-- Banner Area Start -->
            <section class="tmp-banner-slider-area banner-nine banner-wind-energy">
                <div class="swiper thumbBannerSlide-wind">
                    <div class="swiper-wrapper">

                        <% homeBanners.forEach((banner)=> { %>

                            <div class="swiper-slide">

                                <div class="banner-five-main-wrapper industry-banner-before bg-style <%= banner.backgroundClass %>"
                                    style="background-image: url('<%= banner.background %>');">

                                    <div class="container-3">

                                        <div class="row">

                                            <div class="col-xl-12">

                                                <div class="banner-three-wrapper md-sm-controler">

                                                    <span class="b_one-pre cw">

                                                        <%= banner.preTitle %>

                                                    </span>


                                                    <h1 class="title-banner cw">

                                                        <%= banner.title %>
                                                            <br>
                                                            <%= banner.titleLine %>

                                                    </h1>


                                                    <div class="button-area-banner">

                                                        <a href="<%= banner.buttonLink %>"
                                                            class="tmp-btn btn-primary button-flip">

                                                            <span data-text="<%= banner.buttonDataText %>">
                                                                <%= banner.buttonText %>
                                                            </span>

                                                        </a>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <% }) %>

                    </div>

                </div>

                <div class="swiper invers-swiper-thumb-wind tmpmySwiperThumb">
                    <div class="swiper-wrapper">
                    </div>
                </div>

                <div class="navigation-area">
                    <div class="swiper-btn swiper-button-prev">
                        <div class="custom-overfolow-btn">
                            <i class="invers-icon fal fa-arrow-left"></i>
                            <i class="invers-icon-top fal fa-arrow-left"></i>
                        </div>
                    </div>
                    <div class="swiper-btn swiper-button-next">
                        <div class="custom-overfolow-btn">
                            <i class="invers-icon fal fa-arrow-right"></i>
                            <i class="invers-icon-top fal fa-arrow-right"></i>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Banner Area End -->


            <section class="tmp-about-area area-2">

                <!-- Counter Area Start -->
                <div class="tmp-counter-area area-2">

                    <div class="image-area tmp-section-gap about">
                    </div>
                    <div class="counter-inner counter-boxes">

                        <% counters.forEach((counter, index)=> { %>

                            <div class="content counter-box"
                                data-sal="<%= index === 0 ? 'slide-right' : index === counters.length - 1 ? 'slide-left' : 'slide-up' %>"
                                data-sal-duration="1000" data-sal-delay="<%= (index + 1) * 200 %>">

                                <div class="icon">
                                    <img src="<%= counter.icon %>" alt="<%= counter.alt %>">
                                </div>

                                <h3 class="title">
                                    <span class="counter">
                                        <span class="odometer" data-count="<%= counter.value %>">
                                            00
                                        </span>
                                    </span>
                                    <%= counter.suffix %>
                                </h3>

                                <p>
                                    <%= counter.label %>
                                </p>

                            </div>

                            <% }) %>
                    </div>
                </div>
                <!-- Counter Area End -->
            </section>
            <!-- About Area Start -->
            <section class="tmp-about-area area-4 tmp-section-gap pb--150">
                <div class="container-3">
                    <div class="section-inner about-bottom">
                        <div class="row align-items-center">

                            <!-- Left Content -->
                            <div class="col-lg-6">
                                <div class="left-side-content">

                                    <div class="section-title-area-4" data-sal="slide-up" data-sal-duration="800"
                                        data-sal-delay="200">

                                        <p class="sub-title cg">ABOUT COMPANY</p>

                                        <h2 class="section-title tmp-title-split">
                                            Your Trusted Partner for RMC Equipment Solutions
                                        </h2>
                                    </div>

                                    <p class="desc" data-sal="slide-up" data-sal-duration="800" data-sal-delay="300">
                                        N.M. Enterprises is a trusted partner for RMC and concrete
                                        equipment solutions. We provide quality spare parts,
                                        equipment sales and service, maintenance, repair,
                                        technical support, and rental solutions for concrete
                                        pumps, transit mixers, batching plants, and related equipment.
                                    </p>

                                    <ul class="about-feature-list" data-sal="slide-up" data-sal-duration="800"
                                        data-sal-delay="400">

                                        <li class="single">
                                            <div class="icon">
                                                <i class="far fa-check"></i>
                                            </div>
                                            <span>RMC Batching Plant Spare Parts – Sales & Service</span>
                                        </li>

                                        <li class="single">
                                            <div class="icon">
                                                <i class="far fa-check"></i>
                                            </div>
                                            <span>Concrete Pumps, Transit Mixers & Accessories</span>
                                        </li>

                                        <li class="single">
                                            <div class="icon">
                                                <i class="far fa-check"></i>
                                            </div>
                                            <span>Maintenance, Repair, Technical Support & Rental</span>
                                        </li>

                                    </ul>

                                    <div class="button-area-about">

                                        <a href="/about" class="tmp-btn btn-primary hover-icon-reverse btn-md"
                                            data-sal="slide-up" data-sal-duration="800" data-sal-delay="500">

                                            <span class="icon-reverse-wrapper">
                                                <span class="btn-text">Read More</span>

                                                <span class="btn-icon">
                                                    <i class="fa-solid fa-arrow-right"></i>
                                                </span>

                                                <span class="btn-icon">
                                                    <i class="fa-solid fa-arrow-right"></i>
                                                </span>
                                            </span>
                                        </a>

                                        <a href="tel:8320905550" class="text-btn" data-sal="slide-up"
                                            data-sal-duration="800" data-sal-delay="600">

                                            <i class="fa-regular fa-phone"></i>

                                            <span class="hover-moving-primary">
                                                +91 83209 05550
                                            </span>
                                        </a>

                                    </div>

                                </div>
                            </div>

                            <!-- About Image -->
                            <div class="col-lg-6 order-change" data-sal="slide-left" data-sal-duration="800"
                                data-sal-delay="000">

                                <div class="about-image-area3 text-end ">
                                    <img src="/nmenterpriseimages/home/about.png" alt="N.M. Enterprises RMC Equipment">
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </section>
            <!-- About Area End -->

            <!-- Service Area Start -->
            <section class="tmp-service-area area-5 tmp-section-gap">
                <div class="container-3">

                    <div class="section-title-area-3">
                        <p class="sub-title cg" data-sal="slide-up" data-sal-duration="800" data-sal-delay="100">
                            OUR SERVICES
                        </p>

                        <h2 class="section-title tmp-title-split" data-sal="slide-up" data-sal-duration="800"
                            data-sal-delay="300">
                            Powering Your Business <br> the Smart Way
                        </h2>
                    </div>

                    <div class="section-inner mt--60 mt_sm--40">

                        <div class="row g-5">

                            <% services.forEach((service, index)=> { %>

                                <div class="col-lg-4 col-md-6" data-sal="slide-up" data-sal-duration="800"
                                    data-sal-delay="<%= ((index % 3) + 1) * 200 %>">

                                    <div class="service-wrapper7">

                                        <div class="icon">
                                            <img src="<%= service.icon %>" alt="<%= service.alt %>">
                                        </div>
                                        <h3 class="title">
                                            <%= service.title %>
                                        </h3>

                                        <p class="desc">
                                            <%= service.description %>
                                        </p>



                                    </div>

                                </div>

                                <% }); %>

                        </div>

                    </div>

                </div>
            </section>
            <!-- Service Area End -->

            <!-- Why Choose Us Area Start -->
            <section class="tmp-why-choose-us-area3 tmp-section-gap">
                <div class="container-3">

                    <div class="section-title-area-2">

                        <div class="left-side-content">
                            <p class="sub-title cg" data-sal="slide-up-large" data-sal-duration="1000"
                                data-sal-delay="100">
                                WHY CHOOSE US
                            </p>

                            <h2 class="section-title tmp-title-split" data-sal="slide-up-large" data-sal-duration="1000"
                                data-sal-delay="300">
                                Reliable RMC Solutions<br>
                                Built Around Your Needs
                            </h2>
                        </div>

                        <div class="right-side-button">
                            <div class="tmp-button-overlay-with-text btn-xl fw-400">

                                <a href="/contact" class="tmp-icon-overlay-link-btn with-text-btn primary-btn">

                                    <span class="tmp-btn-overlay">
                                        <i class="tmp-icon fa-solid fa-arrow-right"></i>
                                        <i class="tmp-icon-bottom fa-solid fa-arrow-right"></i>
                                    </span>

                                </a>

                                <a class="text-btn" href="/contact">
                                    Contact Us
                                </a>

                            </div>
                        </div>

                    </div>

                    <div class="section-inner mt--60">

                        <div class="row justify-content-between align-items-center">

                            <!-- LEFT FEATURES -->
                            <div class="col-lg-5">

                                <div class="left-side-feature-area">

                                    <ul class="why-choose-wrapper-list2">

                                        <!-- 01 -->
                                        <li data-sal="slide-up" data-sal-duration="1000" data-sal-delay="200">

                                            <div class="icon">
                                                <img src="/nmenterpriseimages/whychooseus/maintenance.png"
                                                    alt="Experienced Technical Team">
                                            </div>

                                            <div class="text">

                                                <h3>Experienced Technical Team</h3>

                                                <p>
                                                    Our trained team provides practical support
                                                    for RMC equipment, maintenance, repair and
                                                    technical requirements.
                                                </p>

                                            </div>

                                        </li>

                                        <!-- 02 -->
                                        <li data-sal="slide-up" data-sal-duration="1000" data-sal-delay="400">

                                            <div class="icon">
                                                <img src="/nmenterpriseimages/whychooseus/engineering.png"
                                                    alt="Reliable Equipment Support">
                                            </div>

                                            <div class="text">

                                                <h3>Reliable Equipment Support</h3>

                                                <p>
                                                    We provide dependable rental equipment and
                                                    support for concrete pumps, transit mixers
                                                    and RMC operations.
                                                </p>

                                            </div>

                                        </li>

                                        <!-- 03 -->
                                        <li data-sal="slide-up" data-sal-duration="1000" data-sal-delay="600">

                                            <div class="icon">
                                                <img src="/nmenterpriseimages/whychooseus/gear.png"
                                                    alt="Quality Spare Parts">
                                            </div>

                                            <div class="text">

                                                <h3>Quality Spare Parts</h3>

                                                <p>
                                                    We supply spare parts and accessories for
                                                    batching plants, pumps, mixers, pipelines
                                                    and related equipment.
                                                </p>

                                            </div>

                                        </li>

                                        <!-- 04 -->
                                        <li data-sal="slide-up" data-sal-duration="1000" data-sal-delay="800">

                                            <div class="icon">
                                                <img src="/nmenterpriseimages/whychooseus/team.png"
                                                    alt="Complete RMC Solutions">
                                            </div>

                                            <div class="text">

                                                <h3>Complete RMC Solutions</h3>

                                                <p>
                                                    From rental and manpower to spare parts,
                                                    maintenance and technical support, we offer
                                                    complete RMC solutions under one roof.
                                                </p>

                                            </div>

                                        </li>

                                    </ul>

                                </div>

                            </div>

                            <!-- RIGHT IMAGE -->
                            <div class="col-lg-6 order-change">

                                <div class="right-side-content">

                                    <div class="image-area">
                                        <img src="/nmenterpriseimages/whychooseus/whychooseus.png"
                                            alt="N.M. Enterprises RMC Equipment">
                                    </div>

                                    <!-- EXPERIENCE CONTENT -->
                                    <div class="content" data-parallax='{"x": 0, "y": 60}'>

                                        <h2 class="title">
                                            <span class="counter">
                                                <span class="odometer" data-count="2015">
                                                    00
                                                </span>
                                            </span>
                                        </h2>

                                        <h3>Established</h3>

                                        <p>
                                            Supporting RMC and concrete construction
                                            requirements with reliable solutions.
                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            </section>
            <!-- Why Choose Us Area End -->

            <!-- Products Area Start -->
            <section class="tmp-service-area area-3 tmp-section-gap">
                <div class="container-3">

                    <!-- SECTION TITLE -->
                    <div class="section-title-area-4 d-flex justify-content-between align-items-center">

                        <div class="left-side-content">
                            <p class="sub-title cg" data-sal="slide-up-large" data-sal-duration="1000"
                                data-sal-delay="100">
                                OUR Products
                            </p>

                            <h2 class="section-title tmp-title-split" data-sal="slide-up-large" data-sal-duration="1000"
                                data-sal-delay="300">
                                Complete RMC &<br>
                                Concrete Equipment Solutions
                            </h2>
                        </div>

                        <div class="right-side-text" data-sal="slide-up-large" data-sal-duration="1000"
                            data-sal-delay="100">

                            <p class="desc">
                                N.M. Enterprises provides reliable sales, service, spare parts,
                                rental equipment, maintenance and technical support for RMC
                                and concrete construction operations.
                            </p>
                        </div>
                    </div>
                    <!-- PRODUCTS SLIDER -->
                    <div class="section-inner mt--40">
                        <div class="slider-inner">
                            <div class="float-right">
                                <div class="swiper tmpServiceSlider">
                                    <div class="swiper-wrapper">

                                        <% products.forEach((product)=> { %>
                                            <div class="swiper-slide">
                                                <div class="service-wrapper-3">
                                                    <div class="top-content text-center"
                                                        style="background-color: #ED1E25; color: #fff !important;">
                                                        <h3 class="projecttitle">
                                                            <%= product.title %>
                                                        </h3>
                                                    </div>
                                                    <div class="image-area">
                                                        <a href="/products">
                                                            <img src="<%= product.image %>" width="531"
                                                                alt="<%= product.alt %>">
                                                        </a>
                                                        <div class="content">
                                                            <a href="/products"
                                                                class="tmp-icon-overlay-link-btn btn-bg-dark btn-xxl">

                                                                <span class="tmp-btn-overlay">
                                                                    <i class="tmp-icon fa-solid fa-arrow-right"></i>
                                                                    <i
                                                                        class="tmp-icon-bottom fa-solid fa-arrow-right"></i>
                                                                </span>
                                                            </a>
                                                            <p class="desc">
                                                                <%= product.description %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <% }); %>
                                    </div>
                                </div>
                            </div>
                            <!-- SLIDER BUTTONS -->
                            <div class="slider-button">

                                <div class="swiper-btn swiper-button-prev">

                                    <div class="custom-overfolow-btn">

                                        <i class="invers-icon fal fa-arrow-left"></i>
                                        <i class="invers-icon-top fal fa-arrow-left"></i>
                                    </div>
                                </div>
                                <div class="swiper-btn swiper-button-next">
                                    <div class="custom-overfolow-btn">

                                        <i class="invers-icon fal fa-arrow-right"></i>
                                        <i class="invers-icon-top fal fa-arrow-right"></i>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Products Area End -->

            <style>
                .contact-map,
                .contact-map iframe {
                    filter: none !important;
                    -webkit-filter: none !important;
                }
            </style>

            <!-- Contact Area Start -->
            <section class="tmp-contact-area tmp-section-gapBottom pt--60 pt_sm--0">
                <div class="container-3">
                    <div class="section-inner">
                        <div class="row g-5">

                            <div class="col-lg-6" data-sal="slide-right" data-sal-duration="800" data-sal-delay="000">

                                <img class="contactus" src="/nmenterpriseimages/contact.png" alt="Contact Us">
                            </div>

                            <div class="col-lg-6" data-sal="slide-left" data-sal-duration="800" data-sal-delay="200">

                                <div class="contact-form-area">

                                    <form id="contactForm" action="/contact" method="POST">

                                        <h4 class="title">Contact With Us</h4>

                                        <div class="form-inner">

                                            <!-- Row 1: Name + Email -->
                                            <div class="row">

                                                <div class="col-md-6 p-2">
                                                    <div class="single-wrapper">
                                                        <label for="name">
                                                            <i class="fa-regular fa-user" style="color: #a80018;"></i>
                                                            Your Name
                                                        </label>

                                                        <input type="text" id="name" name="dzName" required>
                                                    </div>
                                                </div>

                                                <div class="col-md-6 p-2">
                                                    <div class="single-wrapper">
                                                        <label for="email">
                                                            <i class="fa-regular fa-envelope"
                                                                style="color: #a80018;"></i>
                                                            Your Email
                                                        </label>

                                                        <input type="email" id="email" name="dzEmail" required>
                                                    </div>
                                                </div>

                                            </div>


                                            <!-- Row 2: Phone + Subject -->
                                            <div class="row">

                                                <div class="col-md-6 p-2">
                                                    <div class="single-wrapper">
                                                        <label for="phone">
                                                            <i class="fa-solid fa-phone" style="color: #a80018;"></i>
                                                            Your Phone
                                                        </label>

                                                        <input type="tel" id="phone" name="dzOther[Phone]"
                                                            maxlength="10" pattern="[0-9]{10}" required>
                                                    </div>
                                                </div>

                                                <div class="col-md-6 p-2">
                                                    <div class="single-wrapper">
                                                        <label for="subject">
                                                            <i class="fa-regular fa-pen-to-square"
                                                                style="color: #a80018;"></i>
                                                            Subject
                                                        </label>

                                                        <input type="text" id="subject" name="dzOther[Subject]"
                                                            required>
                                                    </div>
                                                </div>

                                            </div>


                                            <!-- Row 3: Message -->
                                            <div class="row">

                                                <div class="col-12 p-2">
                                                    <div class="single-wrapper">

                                                        <label for="message">
                                                            <i class="fa-regular fa-message"
                                                                style="color: #a80018;"></i>
                                                            Your Message
                                                        </label>

                                                        <textarea name="dzMessage" id="message" required></textarea>

                                                    </div>
                                                </div>

                                            </div>


                                            <!-- Success/Error Message -->
                                            <div id="formSuccessMsg"
                                                style="display:none; margin:10px 0; padding:12px; border-radius:5px;">
                                            </div>


                                            <!-- Row 4: Button -->
                                            <div class="single-wrapper">

                                                <button id="submitBtn"
                                                    class="tmp-btn btn-primary hover-icon-reverse w-100" type="submit">

                                                    <span class="icon-reverse-wrapper">

                                                        <span class="btn-text">
                                                            Send Your Message
                                                        </span>

                                                        <span class="btn-icon">
                                                            <i class="fa-solid fa-arrow-right"></i>
                                                        </span>

                                                        <span class="btn-icon">
                                                            <i class="fa-solid fa-arrow-right"></i>
                                                        </span>

                                                    </span>

                                                </button>

                                            </div>

                                        </div>
                                    </form>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>
            <!-- Contact Area End -->

            <%- include('include/footer') %>
            <%- include('include/mobileHeader') %>