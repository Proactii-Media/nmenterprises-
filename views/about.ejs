   <%- include('include/head') %>
  <%- include('include/header') %>
        <style>
            .bg-image-breadcrumb {
                background-image: url(/nmenterpriseimages/banner/about1.png);
            }
        </style>
        
        <!-- tmp breadcrumba area start -->
        <div class="tmp-bread-crumb-area bg-breadcrumb bg-image-breadcrumb bg_image">
            <div class="container-3">
                <div class="row">
                    <div class="col-lg-12">
                        <!-- bread crumb inner wrapper -->
                        <div class="breadcrumb-inner ptb--100 ptb_sm--100 text-center">
                            <h1 class="title">About Us</h1>
                            <div class="meta">
                                <a href="/" class="prev"><i class="fa-solid fa-house"></i> Home</a>
                                <span><i class="fa-regular fa-chevron-right"></i></span>
                                <span>About Us</span>
                            </div>
                        </div>
                        <!-- bread crumb inner wrapper end -->
                    </div>
                </div>
            </div>
        </div>
        <!-- tmp breadcrumba area end -->

        <!-- About Area Start -->
        <section class="tmp-about-area safety tmp-section-gap">
            <div class="container">
                <div class="section-inner">
                    <div class="row align-items-center">

                        <!-- Left Image -->
                        <div class="col-xl-6">
                            <div class="image-area">
                                <img src="/nmenterpriseimages/about/about.png" width="700" alt="N.M. Enterprises">


                            </div>
                        </div>

                        <!-- Right Content -->
                        <div class="col-xl-6 pl--40 mt_lg--30 pl_lg-10 mt_md--30 mt_sm--30 pl_sm--15">

                            <div class="right-content-area">

                                <h2 class="title">
                                    About N. M. Enterprises
                                </h2>

                                <p class="desc mb--20">
                                    N. M. Enterprises was incorporated in 2015 and is a trusted partner
                                    for RMC and concrete equipment requirements. We provide quality
                                    spare parts, reliable products and professional services to support
                                    RMC and concrete construction operations.
                                </p>

                                <p class="desc mb--20">
                                    Our services include RMC batching plant spare parts, concrete pumps,
                                    boom pressure pumps, transit mixers, pump pipelines and accessories,
                                    along with maintenance, repair and technical support.
                                </p>

                                <p class="desc">
                                    We also provide concrete pumps and transit mixers on rental basis,
                                    as well as manpower support for RMC plant, pump and pipeline
                                    operations. Our goal is to provide dependable RMC solutions under
                                    one roof.
                                </p>

                                <div class="tmp-counter-area">
                                    <div class="counter-inner">

                                        <div class="content">
                                            <h3 class="title">
                                                <span class="counter">
                                                    <span class="odometer" data-count="2015">2015</span>
                                                </span>
                                            </h3>
                                            <p>Established</p>
                                        </div>

                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </section>
        <!-- About Area End -->

        <section class="tmp-about-area area-2 pb--80">
            <!-- Counter Area Start -->
            <div class="tmp-counter-area area-2 corevalue">
                <div class="image-area tmp-section-gap about">


                    <div class="counter-inner">

                        <% counters.forEach((counter, index)=> { %>

                            <div class="content"
                                data-sal="<%= index === 0 ? 'slide-right' : index === counters.length - 1 ? 'slide-left' : 'slide-up' %>"
                                data-sal-duration="1000" data-sal-delay="<%= (index + 1) * 200 %>">

                                <div class="icon">

                                    <img src="<%= counter.icon %>" alt="<%= counter.alt %>">

                                </div>


                                <h3 class="title">

                                    <span class="counter">

                                        <span class="odometer" data-count="<%= counter.value %>">
                                            00
                                        </span>

                                    </span>

                                    <%= counter.suffix %>

                                </h3>


                                <p>
                                    <%= counter.label %>
                                </p>

                            </div>

                            <% }) %>

                    </div>
                </div>
            </div>
            <!-- Counter Area End -->
        </section>

        <!-- =====================================================
     MISSION & VISION
====================================================== -->

        <section class="mission-vision-section tmp-section-gap">
            <div class="container ">
                <div class="row justify-content-center">

                    <div class="col-lg-8 text-center mb-5">
                        <h2 class="mv-title-main mb-4">
                            Mission <span>&amp;</span> Vision
                        </h2>

                        <p class="mv-intro mx-auto mb-0">

                            Our mission is to provide reliable RMC and concrete equipment solutions with quality
                            products and services. Our vision is to build long-term customer relationships through
                            dependable support and continuous improvement.
                        </p>
                    </div>
                </div>
                <div class="mv-wrapper position-relative">
                    <div class="row g-4">
                        <div class="col-12 col-lg-6 ">
                            <div class="mv-card h-100">
                                <div class="mv-card-bar mission-bar"></div>
                                <div class="mv-number">
                                    01
                                </div>
                                <div class="mv-decoration mission-decoration"></div>
                                <div class="mv-content p-4 p-lg-5">
                                    <div class="mv-icon mission-icon mb-4">

                                        <i class="bi bi-bullseye"></i>

                                    </div>

                                    <div class="mv-label mission-label mb-2">

                                        Our Purpose

                                    </div>
                                    <h3 class="mv-card-title mb-3">

                                        Mission

                                    </h3>

                                    <p class="mv-description mb-0">

                                        To provide reliable RMC and concrete equipment solutions with quality products,
                                        professional services, and timely technical support. We strive to understand
                                        customer requirements and deliver practical solutions that support smooth and
                                        efficient operations.

                                    </p>
                                    <div class="mv-line mission-line mt-4"></div>
                                </div>

                            </div>

                        </div>

                        <!-- =========================================
                     VISION
                ========================================== -->

                        <div class="col-12 col-lg-6">
                            <div class="mv-card h-100">
                                <div class="mv-card-bar vision-bar"></div>

                                <div class="mv-number">
                                    02
                                </div>
                                <div class="mv-decoration vision-decoration"></div>
                                <div class="mv-content p-4 p-lg-5">
                                    <div class="mv-icon vision-icon mb-4">
                                        <i class="bi bi-lightbulb"></i>
                                    </div>

                                    <div class="mv-label vision-label mb-2">

                                        Our Future

                                    </div>
                                    <h3 class="mv-card-title mb-3">
                                        Vision
                                    </h3>

                                    <p class="mv-description mb-0">

                                        To build long-term relationships with our customers by maintaining quality,
                                        reliability, and professional service. We aim to be a trusted one-stop partner
                                        for RMC and concrete equipment requirements.

                                    </p>
                                    <div class="mv-line vision-line mt-4"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </section>

        <%- include('include/footer') %>
        <%- include('include/mobileHeader') %>