<!DOCTYPE html>
<html lang="en">


<!-- Mirrored from html.inversweb.com/constx/contact-2.html by HTTrack Website Copier/3.x [XR&CO'2014], Wed, 23 Sep 2026 06:24:11 GMT -->
<%- include('include/head') %>

    <style>
        .bg-image-breadcrumb {
            background-image: url(/nmenterpriseimages/banner/service.png);
        }

        .service-wrapper7 {
            position: relative;
            overflow: hidden;
            padding: 30px;
            border: 1px solid #e80028;
            border-radius: 12px;
            background: #fff4e8;
            transition: all 0.3s ease;
        }

        /* Odd cards = Light Orange */
        .row>div:nth-child(odd) .service-wrapper7 {
            background: #fff4e8;
        }

        /* Even cards = White */
        .row>div:nth-child(even) .service-wrapper7 {
            background: #ffffff;
        }

        /* =========================
   ICON
========================= */

        .service-wrapper7 .icon {
            width: 90px;
            height: 90px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: all 0.3s ease;
        }

        /* Orange card → White icon */
        .row>div:nth-child(odd) .service-wrapper7 .icon {
            background: #ffffff;
        }

        /* White card → Red icon */
        .row>div:nth-child(even) .service-wrapper7 .icon {
            background: #fff4e8;
        }

        .service-wrapper7 .icon img {
            width: 50px;
            height: 50px;
            object-fit: contain;
        }

        /* Bottom red line */
        .service-wrapper7::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 0;
            height: 3px;
            background: #e80028;
            transition: width 0.4s ease;
        }

        .service-wrapper7:hover::after {
            width: 100%;
        }
    </style>



    <body class="home-inner home-green">

        <!-- Header Start -->
        <div class="loader-wrapper">
            <div class="loader">
            </div>
            <div class="loader-section section-left"></div>
            <div class="loader-section section-right"></div>
        </div>

        <%- include('include/header') %>

            <!-- tmp breadcrumba area start -->
            <div class="tmp-bread-crumb-area bg-breadcrumb bg-image-breadcrumb bg_image">
                <div class="container-3">
                    <div class="row">
                        <div class="col-lg-12">
                            <!-- bread crumb inner wrapper -->
                            <div class="breadcrumb-inner ptb--100 ptb_sm--100 text-center">
                                <h1 class="title">Our Services</h1>
                                <div class="meta">
                                    <a href="/" class="prev"><i class="fa-solid fa-house"></i> Home</a>
                                    <span><i class="fa-regular fa-chevron-right"></i></span>
                                    <span>Our Services</span>
                                </div>
                            </div>
                            <!-- bread crumb inner wrapper end -->
                        </div>
                    </div>
                </div>
            </div>
            <!-- tmp breadcrumba area end -->




            <!-- Service Area Start -->
            <section class="tmp-service-area area-5 tmp-section-gap">
                <div class="container-3">

                    <div class="section-title-area-3">


                        <h2 class="section-title tmp-title-split" data-sal="slide-up" data-sal-duration="800"
                            data-sal-delay="300">
                            Complete Concrete Solutions <br> for Every Project
                        </h2>
                    </div>

                    <div class="section-inner mt--60 mt_sm--40">

                        <div class="row g-5">

                            <% services.forEach((service, index)=> { %>

                                <div class="col-lg-4 col-md-6" data-sal="slide-up" data-sal-duration="800"
                                    data-sal-delay="<%= ((index % 3) + 1) * 200 %>">

                                    <div class="service-wrapper7">

                                        <div class="icon">
                                            <img src="<%= service.icon %>" alt="<%= service.alt %>">
                                        </div>
                                        <h3 class="title">
                                            <%= service.title %>
                                        </h3>

                                        <p class="desc">
                                            <%= service.description %>
                                        </p>
                                    </div>

                                </div>

                                <% }); %>

                        </div>

                    </div>

                </div>
            </section>
            <!-- Service Area End -->

            <!-- tmp footer area start -->
            <%- include('include/footer') %>

                <!-- tmp footer area end -->

                <%- include('include/mobileHeader') %>