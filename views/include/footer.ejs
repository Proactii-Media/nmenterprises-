<script>
    (function () {

        const form = document.getElementById("contactForm");
        const submitBtn = document.getElementById("submitBtn");
        const successMsg = document.getElementById("formSuccessMsg");

        if (!form || !submitBtn || !successMsg) {
            console.error("Contact form elements not found.");
            return;
        }

        form.addEventListener("submit", async function (e) {

            e.preventDefault();

            successMsg.style.display = "none";
            successMsg.textContent = "";

            submitBtn.disabled = true;

            const originalText = submitBtn.querySelector(".btn-text");

            if (originalText) {
                originalText.textContent = "Sending...";
            }

            const formData = new URLSearchParams(new FormData(form));

            try {

                const response = await fetch("/contact", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: formData
                });

                const result = await response.json();

                console.log("Server response:", result);

                if (response.ok && result.success === true) {

                    successMsg.style.display = "block";
                    successMsg.style.background = "#e8f8ee";
                    successMsg.style.color = "#198754";
                    successMsg.style.border = "1px solid #b7e4c7";

                    successMsg.textContent =
                        "✅ Your message has been sent successfully!";

                    form.reset();

                } else {

                    successMsg.style.display = "block";
                    successMsg.style.background = "#fff1f1";
                    successMsg.style.color = "#d71920";
                    successMsg.style.border = "1px solid #f1c1c1";

                    successMsg.textContent =
                        "❌ " + (result.message || "Something went wrong. Please try again.");
                }

            } catch (error) {

                console.error("Contact form error:", error);

                successMsg.style.display = "block";
                successMsg.style.background = "#fff1f1";
                successMsg.style.color = "#d71920";
                successMsg.style.border = "1px solid #f1c1c1";

                successMsg.textContent =
                    "❌ Unable to connect to server. Please try again.";

            } finally {

                submitBtn.disabled = false;

                if (originalText) {
                    originalText.textContent = "Send Your Message";
                }

            }

        });

    })();
</script>



