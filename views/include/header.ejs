<style>
    .header-top {
        overflow: visible !important;
    }

    .float-text.show-on-scroll.hide-scroll-button {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
        pointer-events: none !important;
    }




    .float-text.show-on-scroll {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
    }

    .scroll-top-circle {
        width: 55px !important;
        height: 55px !important;
        min-width: 55px !important;
        min-height: 55px !important;

        border: 2px solid #c00020 !important;
        border-radius: 50% !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        color: #c00020 !important;
        background: #fff !important;

        text-decoration: none !important;
        font-size: 18px;
        line-height: 1;

        box-sizing: border-box;
        transition: all 0.3s ease;
    }

    .scroll-top-circle:hover {
        background: #c00020 !important;
        color: #fff !important;
        transform: translateY(-4px);
    }

    .scroll-top-circle i {
        margin: 0 !important;
        padding: 0 !important;
        line-height: 1 !important;
    }

    /* Mobile */
    @media (max-width: 767px) {
        .float-text.show-on-scroll {
            display: none !important;
        }
    }
</style>

<div class="float-text show-on-scroll">
    <a href="#" class="scroll-top-circle" aria-label="Scroll to top">
        <i class="fa-solid fa-arrow-up"></i>
    </a>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const scrollButton = document.querySelector(".float-text.show-on-scroll");

        if (!scrollButton) return;

        function toggleScrollButton() {
            if (window.scrollY <= 50) {
                scrollButton.classList.add("hide-scroll-button");
            } else {
                scrollButton.classList.remove("hide-scroll-button");
            }
        }

        toggleScrollButton();

        window.addEventListener("scroll", toggleScrollButton);
    });
</script>