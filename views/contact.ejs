<!DOCTYPE html>
<html lang="en">

<%- include('include/head') %>

    <style>
        .bg-image-breadcrumb {
            background-image: url(/nmenterpriseimages/banner/contactbanner.png);
        }
    </style>


    <body class="home-inner home-green">

        <!-- Header Start -->
        <div class="loader-wrapper">
            <div class="loader">
            </div>
            <div class="loader-section section-left"></div>
            <div class="loader-section section-right"></div>
        </div>

        <%- include('include/header') %>

            <!-- tmp breadcrumba area start -->
            <div class="tmp-bread-crumb-area bg-breadcrumb bg-image-breadcrumb bg_image">
                <div class="container-3">
                    <div class="row">
                        <div class="col-lg-12">
                            <!-- bread crumb inner wrapper -->
                            <div class="breadcrumb-inner ptb--100 ptb_sm--100 text-center">
                                <h1 class="title">Contact Us</h1>
                                <div class="meta">
                                    <a href="/" class="prev"><i class="fa-solid fa-house"></i> Home</a>
                                    <span><i class="fa-regular fa-chevron-right"></i></span>
                                    <span>Contact Us</span>
                                </div>
                            </div>
                            <!-- bread crumb inner wrapper end -->
                        </div>
                    </div>
                </div>
            </div>
            <!-- tmp breadcrumba area end -->

            <!-- Get In Touch Area End -->
            <section class="tmp-get-in-touch-area area-3 tmp-section-gap">
                <div class="container-3">
                    <div class="section-inner-1">
                        <div class="row g-5">

                            <div class="col-lg-4 col-md-6" data-sal="slide-right" data-sal-duration="800"
                                data-sal-delay="300">
                                <div class="get-in-touch-wrapper">
                                    <div class="icons">
                                        <i class="fa-solid fa-phone"></i>
                                    </div>
                                    <h2 class="title">Contact Mobile Number</h2>
                                    <p>
                                        <a class="hover-moving-primary" href="tel:+918320905550">
                                            +91&nbsp;83209&nbsp;05550
                                        </a>
                                    </p>
                                    <p>
                                        <a class="hover-moving-primary" href="tel:+917698299787">
                                            +91&nbsp;76982&nbsp;99787
                                        </a>
                                    </p>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-6" data-sal="slide-right" data-sal-duration="800"
                                data-sal-delay="500">
                                <div class="get-in-touch-wrapper">
                                    <div class="icons"><i class="fa-regular fa-envelope-open"></i></div>
                                    <h2 class="title">Our Email Address</h2>
                                    <p><a class="hover-moving-primary"
                                            href="mailto:services@nm-enterprises.in">services@nm-enterprises.in</a>
                                    </p>
                                    <p><a class="hover-moving-primary"
                                            href="mailto:info@nm-enterprises.in">info@nm-enterprises.in</a>
                                    </p>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-6" data-sal="slide-right" data-sal-duration="800"
                                data-sal-delay="700">
                                <div class="get-in-touch-wrapper">
                                    <div class="icons"><i class="fa-solid fa-map-marker-alt"></i></i></div>
                                    <h2 class="title">Head Office Location</h2>
                                    <p>Ground Floor, Shop No. E-1, Plot No. 02 To 04 / 08 To 13,
                                        Situated At NH. No. 08, Shivenbuildcon LLP,
                                        S. No. 2471 & Other, Village : Salvav Taluka : Pardi Dist : Valsad</p>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>
            <!-- Get In Touch Area Start -->

            <!-- Contact Area Start -->
            <section class="tmp-contact-area tmp-section-gapBottom pt--60 pt_sm--0">
                <div class="container-3">
                    <div class="section-inner">
                        <div class="row g-5">

                            <div class="col-lg-6" data-sal="slide-right" data-sal-duration="800" data-sal-delay="000">

                                <img class="contactus" src="/nmenterpriseimages/contact.png" alt="Contact Us">
                            </div>

                            <div class="col-lg-6" data-sal="slide-left" data-sal-duration="800" data-sal-delay="200">

                                <div class="contact-form-area">

                                    <form id="contactForm" action="/contact" method="POST">

                                        <h4 class="title">Contact With Us</h4>

                                        <div class="form-inner">

                                            <!-- Row 1: Name + Email -->
                                            <div class="row">

                                                <div class="col-md-6 p-2">
                                                    <div class="single-wrapper">
                                                        <label for="name">
                                                            <i class="fa-regular fa-user" style="color: #a80018;"></i>
                                                            Your Name
                                                        </label>

                                                        <input type="text" id="name" name="dzName" required>
                                                    </div>
                                                </div>

                                                <div class="col-md-6 p-2">
                                                    <div class="single-wrapper">
                                                        <label for="email">
                                                            <i class="fa-regular fa-envelope"
                                                                style="color: #a80018;"></i>
                                                            Your Email
                                                        </label>

                                                        <input type="email" id="email" name="dzEmail" required>
                                                    </div>
                                                </div>

                                            </div>


                                            <!-- Row 2: Phone + Subject -->
                                            <div class="row">

                                                <div class="col-md-6 p-2">
                                                    <div class="single-wrapper">
                                                        <label for="phone">
                                                            <i class="fa-solid fa-phone" style="color: #a80018;"></i>
                                                            Your Phone
                                                        </label>

                                                        <input type="tel" id="phone" name="dzOther[Phone]"
                                                            maxlength="10" pattern="[0-9]{10}" required>
                                                    </div>
                                                </div>

                                                <div class="col-md-6 p-2">
                                                    <div class="single-wrapper">
                                                        <label for="subject">
                                                            <i class="fa-regular fa-pen-to-square"
                                                                style="color: #a80018;"></i>
                                                            Subject
                                                        </label>

                                                        <input type="text" id="subject" name="dzOther[Subject]"
                                                            required>
                                                    </div>
                                                </div>

                                            </div>


                                            <!-- Row 3: Message -->
                                            <div class="row">

                                                <div class="col-12 p-2">
                                                    <div class="single-wrapper">

                                                        <label for="message">
                                                            <i class="fa-regular fa-message"
                                                                style="color: #a80018;"></i>
                                                            Your Message
                                                        </label>

                                                        <textarea name="dzMessage" id="message" required></textarea>

                                                    </div>
                                                </div>

                                            </div>


                                            <!-- Success/Error Message -->
                                            <div id="formSuccessMsg"
                                                style="display:none; margin:10px 0; padding:12px; border-radius:5px;">
                                            </div>


                                            <!-- Row 4: Button -->
                                            <div class="single-wrapper">

                                                <button id="submitBtn"
                                                    class="tmp-btn btn-primary hover-icon-reverse w-100" type="submit">

                                                    <span class="icon-reverse-wrapper">

                                                        <span class="btn-text">
                                                            Send Your Message
                                                        </span>

                                                        <span class="btn-icon">
                                                            <i class="fa-solid fa-arrow-right"></i>
                                                        </span>

                                                        <span class="btn-icon">
                                                            <i class="fa-solid fa-arrow-right"></i>
                                                        </span>

                                                    </span>

                                                </button>

                                            </div>

                                        </div>
                                    </form>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>
            <!-- Contact Area End -->

            <!-- tmp footer area start -->
            <%- include('include/footer') %>
            <%- include('include/mobileHeader') %>